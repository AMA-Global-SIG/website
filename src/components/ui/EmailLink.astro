---
interface Props {
  address: string;
}

const { address } = Astro.props;
---

<a
  href={`mailto:${address}`}
  class="text-brand-500 dark:text-brand-250 font-medium hover:text-brand-600 inline-flex items-center gap-1.5"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  <span class="underline underline-offset-2">Email</span>
</a>
