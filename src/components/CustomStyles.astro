---
// Body font: Source Sans 3 (loaded below via Google Fonts).
// Heading font: Source Serif 4 (loaded below via Google Fonts).
// These are sibling families from Adobe, designed to work together.
// To revert: swap the Google Fonts <link> and restore the three --aw-font-* vars.
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
  rel="stylesheet"
/>

<style is:inline>
  :root {
    --aw-font-sans: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Source Serif 4', ui-serif, Georgia, serif;
    --aw-font-heading: 'Source Serif 4', ui-serif, Georgia, serif;

    --aw-color-primary: rgb(61 94 155);
    --aw-color-secondary: rgb(31 48 79);
    --aw-color-accent: rgb(76 117 193);

    --aw-color-text-heading: rgb(31 48 79);
    --aw-color-text-default: rgb(31 48 79);
    --aw-color-text-muted: rgb(31 48 79 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --tw-prose-headings: rgb(31 48 79);

    --aw-color-bg-page-dark: rgb(31 48 79);

    ::selection {
      background-color: rgb(198 212 233);  /* brand-150 */
      color: rgb(31 48 79);  /* brand-800 */
    }
  }

  /* Source Serif 4 uses variable optical sizing — let the browser pick. */
  .font-heading {
    font-optical-sizing: auto;
  }

  .dark {
    --aw-font-sans: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Source Serif 4', ui-serif, Georgia, serif;
    --aw-font-heading: 'Source Serif 4', ui-serif, Georgia, serif;

    --aw-color-primary: rgb(118 147 191);
    --aw-color-secondary: rgb(97 131 184);
    --aw-color-accent: rgb(138 163 204);

    --aw-color-text-heading: rgb(241 244 249);
    --aw-color-text-default: rgb(224 231 242);

    --tw-prose-headings: rgb(241 244 249);
    --aw-color-text-muted: rgb(198 212 233 / 80%);
    --aw-color-bg-page: rgb(31 48 79);

    ::selection {
      background-color: rgb(76 117 193);
      color: rgb(241 244 249);
    }
  }
</style>
