---
import { Image } from 'astro:assets';
import logoLight from '~/assets/images/default_light.png';
import logoDark from '~/assets/images/default_dark.png';
---

<Image src={logoLight} alt="AMA Global Marketing SIG" class="h-8 w-auto dark:hidden" loading="eager" />
<Image src={logoDark} alt="AMA Global Marketing SIG" class="h-8 w-auto hidden dark:block" loading="eager" />
