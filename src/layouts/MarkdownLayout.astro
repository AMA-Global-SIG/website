---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    wide?: boolean;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};

const maxWidth = frontmatter?.wide ? 'max-w-6xl' : 'max-w-4xl';
---

<Layout metadata={metadata}>
  <section class={`px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 ${maxWidth}`}>
    <h1 class="font-bold font-heading text-heading text-4xl md:text-5xl leading-tighter tracking-tighter">
      {frontmatter.title}
    </h1>
    <div
      class={`mx-auto prose prose-lg ${maxWidth} dark:prose-invert prose-headings:text-heading dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-brand-500 dark:prose-a:text-brand-250 prose-img:rounded-md prose-img:shadow-lg mt-8`}
    >
      <slot />
    </div>
  </section>
</Layout>
